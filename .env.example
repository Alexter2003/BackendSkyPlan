# Supabase → Project Settings → Database → Connection string
# Session mode (port 5432) — used by the app at runtime. Avoids the
# per-query BEGIN/DEALLOCATE ALL/COMMIT wrapping Prisma adds when it detects
# pgbouncer transaction-mode pooling (port 6543); that wrapping quadruples
# round-trips per query and isn't needed for a long-lived Nest process.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# Same connection, used by `prisma migrate`
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

NODE_ENV=development
PORT=3000

# Rounds for bcrypt password hashing (optional, defaults to 12 in code)
BCRYPT_SALT_ROUNDS=12

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM="SkyPlan <no-reply@skyplan.alexvyumes-dev.com>"
